{
  "uid": "kongsberg-monitoring",
  "title": "Kongsberg Security and Containers",
  "tags": ["trivy", "security", "cadvisor"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Vulnerabilities by image and severity",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "trivy_vulnerabilities_total",
          "legendFormat": "{{image}} - {{severity}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Critical vulnerabilities",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(trivy_vulnerabilities_total{severity=\"critical\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "High vulnerabilities",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(trivy_vulnerabilities_total{severity=\"high\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "SBOM components",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sbom_component_info",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "image": 0,
              "package": 1,
              "version": 2
            },
            "renameByName": {
              "image": "Image",
              "package": "Package",
              "version": "Version"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "API SBOM components",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sbom_components_total{image=\"api\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Frontend SBOM components",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sbom_components_total{image=\"frontend\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Web static analysis errors",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "web_static_analysis_errors_total",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Web static analysis warnings",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "web_static_analysis_warnings_total",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Files with static analysis issues",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "web_static_analysis_files_with_errors_total + web_static_analysis_files_with_warnings_total",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Container CPU usage",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total[5m]) * 100",
          "legendFormat": "{{id}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container memory usage",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_usage_bytes",
          "legendFormat": "{{id}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container CPU throttling",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_cfs_throttled_seconds_total[5m])",
          "legendFormat": "{{id}}"
        }
      ]
    }
  ]
}
